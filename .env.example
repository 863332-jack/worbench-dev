# 复制本文件为 .env，然后把密码改成你自己的
#   cp .env.example .env && chmod 600 .env
#
# 注意：
#   1. .env 已在 .gitignore 里，不会被提交
#   2. 这个密码能清空历史库、删除历史记录、导出全部账单，务必用强密码
#   3. 之前代码里内置的 13662566518 已随公开仓库暴露，不要再用

RECON_ADMIN_PASSWORD=请改成你自己的强密码

# ---------- 匹配规则参数（可选，不写则用默认值） ----------
# 低数量复核阈值（件）：单价与历史最低价一致，但该价位的历史订单数量最多仍低于此值时，
# 不判「已匹配最低价」，转「需人工复核」——数量过少多为打样/小批量价，不代表批量做货价。
# 设为 0 可关闭该规则。
# RECON_LOW_QTY_THRESHOLD=20

# 上传原件/导出结果保留天数（默认 90）
# RECON_RETENTION_DAYS=90
